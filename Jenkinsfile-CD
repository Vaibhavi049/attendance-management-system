pipeline {
    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['Staging', 'Production'],
            description: 'Select deployment environment'
        )

        string(
            name: 'BUILD_NUMBER',
            defaultValue: '1',
            description: 'Enter Docker image build number'
        )
    }

    environment {

        AWS_ACCOUNT_ID = '639642129219'
        AWS_REGION = 'ap-south-1'
        IMAGE_NAME = 'attendance-management-system'
        EC2_IP = '52.66.202.182'
    }

    stages {

        stage('Deploy to EC2') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-user1',
                        keyFileVariable: 'KEYFILE'
                    )
                ]) {

                    bat """
                    REM ===== FIX SSH KEY PERMISSIONS =====
                    icacls %KEYFILE% /inheritance:r
                    icacls %KEYFILE% /grant:r "NT AUTHORITY\\SYSTEM:R"
                    icacls %KEYFILE% /grant:r "Administrators:R"

                    REM ===== DEPLOY APPLICATION =====
                    ssh -o StrictHostKeyChecking=no -i %KEYFILE% ec2-user@%EC2_IP% "aws ecr get-login-password --region %AWS_REGION% | docker login --username AWS --password-stdin %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com && docker stop attendance-app || true && docker rm attendance-app || true && docker pull %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com/%IMAGE_NAME%:%BUILD_NUMBER% && docker run -d -p 9090:9090 --name attendance-app %AWS_ACCOUNT_ID%.dkr.ecr.%AWS_REGION%.amazonaws.com/%IMAGE_NAME%:%BUILD_NUMBER%"

                    REM ===== FORCE SUCCESS =====
                    exit /b 0
                    """
                }
            }
        }
    }

    post {

        success {

            emailext(
                to: 'vaibhaviagrawal24@gmail.com',
                from: 'vaibhaviagrawal24@gmail.com',
                replyTo: 'vaibhaviagrawal24@gmail.com',
                subject: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
CD Pipeline Deployment Successful

Job Name: ${env.JOB_NAME}
Build Number: ${params.BUILD_NUMBER}
Environment: ${params.ENVIRONMENT}

Application deployed successfully on EC2.

EC2 Server:
http://${env.EC2_IP}:9090

Build URL:
${env.BUILD_URL}
""",
                mimeType: 'text/plain'
            )
        }

        failure {

            emailext(
                to: 'vaibhaviagrawal24@gmail.com',
                from: 'vaibhaviagrawal24@gmail.com',
                replyTo: 'vaibhaviagrawal24@gmail.com',
                subject: "FAILURE: ${env.JOB_NAME} #${env.BUILD_NUMBER}",
                body: """
CD Pipeline Deployment Failed

Job Name: ${env.JOB_NAME}
Build Number: ${params.BUILD_NUMBER}
Environment: ${params.ENVIRONMENT}

Deployment failed on EC2.

Check Jenkins console logs for details.

Build URL:
${env.BUILD_URL}
""",
                mimeType: 'text/plain'
            )
        }

        always {
            echo 'CD Pipeline execution completed.'
        }
    }
}