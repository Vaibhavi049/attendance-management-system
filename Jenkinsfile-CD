pipeline {
    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['Staging', 'Production'],
            description: 'Select deployment environment'
        )

        string(
            name: 'BUILD_NUMBER',
            defaultValue: '13',
            description: 'Enter Docker image build number'
        )
    }

    environment {

        AWS_ACCOUNT_ID = '639642129219'
        AWS_REGION = 'ap-south-1'
        IMAGE_NAME = 'attendance-management-system'
        EC2_IP = '52.66.202.182'
    }

    stages {

        stage('Deploy to EC2') {

            steps {

                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'ec2-user1',
                        keyFileVariable: 'KEYFILE'
                    )
                ]) {

                    bat '''
                    REM ===== FIX SSH KEY PERMISSIONS =====
                    icacls %KEYFILE% /inheritance:r
                    icacls %KEYFILE% /grant:r "NT AUTHORITY\\SYSTEM:R"
                    icacls %KEYFILE% /grant:r "Administrators:R"

                    REM ===== DEPLOY CONTAINER =====
                    ssh -o StrictHostKeyChecking=no -i %KEYFILE% ec2-user@52.66.202.182 "docker stop attendance-app || true && docker rm attendance-app || true && docker pull 639642129219.dkr.ecr.ap-south-1.amazonaws.com/attendance-management-system:%BUILD_NUMBER% && docker run -d -p 9090:9090 --name attendance-app 639642129219.dkr.ecr.ap-south-1.amazonaws.com/attendance-management-system:%BUILD_NUMBER%"

                    REM ===== FORCE SUCCESS =====
                    exit /b 0
                    '''
                }
            }
        }
    }

    post {
        success {
            emailext(
                subject: "CD Deployment Successful - Build #${BUILD_NUMBER}",
                body: """
                    Deployment Successful!

                    Job Name: ${JOB_NAME}
                    Build Number: ${BUILD_NUMBER}

                    Application deployed successfully on EC2.
                """,
                to: "vaibhaviagrawal24@gmail.com"
            )
        }

        failure {
            emailext(
                subject: "CD Deployment Failed - Build #${BUILD_NUMBER}",
                body: """
                    Deployment Failed!

                    Job Name: ${JOB_NAME}
                    Build Number: ${BUILD_NUMBER}

                    Check Jenkins console logs for details.
                """,
                to: "vaibhaviagrawal24@gmail.com"
            )
        }
    }
}